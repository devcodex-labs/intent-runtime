{
  "name": "@devcodex-labs/intent-runtime",
  "version": "1.0.0-dev.0",
  "description": "A pure Node.js library for turning natural language or external inputs into standardized, structured, verifiable, extensible, and traceable intent records.",
  "type": "module",
  "license": "MIT",
  "author": "devcodex-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devcodex-labs/intent-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/devcodex-labs/intent-runtime/issues"
  },
  "homepage": "https://devcodex-labs.github.io/intent-runtime/",
  "keywords": [
    "intent",
    "runtime",
    "schema",
    "validation",
    "traceability",
    "natural-language",
    "mcp",
    "codex",
    "schema-dsl",
    "openai",
    "xai"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/api": {
      "types": "./dist/adapters/api/index.d.ts",
      "import": "./dist/adapters/api/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js"
    },
    "./mcp": {
      "types": "./dist/transports/mcp/index.d.ts",
      "import": "./dist/transports/mcp/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "scripts/postinstall.mjs",
    "integrations",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-runtime-data.mjs",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run clean && npm run build",
    "test": "vitest run tests",
    "test:integration": "npm run build && node scripts/integration.mjs",
    "test:mcp": "npm run build && node evaluations/mcp-protocol.mjs",
    "evaluate": "npm run build && node evaluations/run.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests && node scripts/check-imports.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:installation": "node scripts/smoke-installation.mjs",
    "smoke:maintenance": "node scripts/smoke-maintenance.mjs",
    "smoke:validation": "node scripts/smoke-validation.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "registry:refresh": "node scripts/refresh-language-registry.mjs",
    "docs:dev": "npm --prefix website run dev",
    "docs:build": "npm --prefix website run build",
    "docs:preview": "npm --prefix website run preview",
    "docs:check": "npm --prefix website run check",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "intent-runtime-mcp": "dist/transports/mcp/main.js",
    "intent-runtime": "dist/installation/cli.js"
  },
  "dependencies": {
    "bcp-47": "2.1.1",
    "jsonc-parser": "3.3.1",
    "schema-dsl": "3.0.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "toml-eslint-parser": "0.10.0"
  },
  "peerDependencies": {
    "openai": ">=6.49.0 <7"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "eslint": "9.39.4",
    "language-subtag-registry": "0.4.2",
    "openai": "6.49.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vitest": "3.2.6",
    "vite": "6.4.1"
  }
}
