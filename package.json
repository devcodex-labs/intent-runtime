{
  "name": "@devcodex/intent-runtime",
  "version": "2.0.0",
  "description": "A model-driven Node.js component that structures user intent and extracts schema-defined data for applications and MCP servers.",
  "type": "module",
  "license": "MIT",
  "author": "devcodex-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devcodex-labs/intent-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/devcodex-labs/intent-runtime/issues"
  },
  "homepage": "https://devcodex-labs.github.io/intent-runtime/",
  "keywords": [
    "intent",
    "runtime",
    "schema",
    "validation",
    "traceability",
    "natural-language",
    "mcp",
    "codex",
    "schema-dsl",
    "openai",
    "xai"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/api": {
      "types": "./dist/adapters/api.d.ts",
      "import": "./dist/adapters/api.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "integrations/codex/SKILL.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schema:generate": "node scripts/generate-schema.mjs",
    "lint": "node scripts/check-imports.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:release": "node --test scripts/check-release.test.mjs scripts/release-registry.test.mjs",
    "release:registry": "node scripts/release-registry.mjs",
    "docs:check": "npm --prefix website run check",
    "docs:build": "npm --prefix website run build",
    "prepack": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "intent-runtime-mcp": "dist/cli/mcp.js",
    "intent-runtime": "dist/cli/index.js"
  },
  "dependencies": {
    "bcp-47": "2.1.1",
    "toml-eslint-parser": "0.10.0"
  },
  "peerDependencies": {
    "schema-dsl": "3.0.4"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "typescript": "5.9.3",
    "schema-dsl": "3.0.4",
    "esbuild": "0.28.2",
    "typescript-json-schema": "0.68.0"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/client": "2.3.1"
  }
}
