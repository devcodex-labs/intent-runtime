  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@rspress/core": "2.0.23",
    "@rspress/plugin-sitemap": "2.0.23"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "parse5": "7.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3"
  }
}
